rules_version = '2';
// 0.7.2: design docs/versions/V7/0.7.2/DESIGN_V1.md §2. Two independent layers, matching
// ARCHITECTURE_CURRENT_STATE.md's "Application access, Trip ownership and revoked-account
// lifecycle" section: application-level invitation (is this email allowed to use FamilyTrips at
// all) and Trip-level access (Owner: ownerUid; Editor: editorEmails, checked by email since an
// invited Editor may not have signed in yet at grant time -- see DESIGN_V1.md §1.4 for why email,
// not uid).
// 0.7.5 (DESIGN_V1.md §2/§3): the application-invitation layer moved from a single flat
// config/appInvitations document (seeded to mirror the FAMILYTRIPS_ALLOWED_EMAILS Netlify env var,
// a separate, unsynced store) to a real invitations/{email} collection -- keyed by the plain
// lowercased email (Firestore rules cannot compute SHA-256, and an email is already a valid
// document ID), each document {email, state:'active'|'revoked', isAdmin, invitedAt, revokedAt}.
// isInvited() now reads this collection directly, so revoking an account (setting state:'revoked')
// blocks Trips/Storage/Smart Import (netlify/functions/_shared/smart-import-auth.mjs, same
// collection via Firestore REST) with this one write -- no per-Trip fan-out needed, and Editor
// access on OTHER people's Trips is blocked for free too, since hasTripAccess() below requires
// isInvited() regardless of editorEmails membership (DESIGN_V1.md §3, open question 3).
service cloud.firestore {
  match /databases/{database}/documents {

    function callerInvitationPath() {
      return /databases/$(database)/documents/invitations/$(request.auth.token.email);
    }
    // exists() guarded explicitly, not left to fail-closed-on-missing-document semantics: every
    // email that was never invited at all (not just one that was later revoked) hits this path --
    // unlike the predecessor config/appInvitations single document, which always existed once
    // seeded, invitations/{email} genuinely may not exist for an arbitrary caller.
    function isInvited() {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        exists(callerInvitationPath()) &&
        get(callerInvitationPath()).data.state == 'active';
    }
    function isAdmin() {
      return isInvited() && get(callerInvitationPath()).data.isAdmin == true;
    }
    function isOwner(trip) { return request.auth.uid == trip.data.ownerUid; }
    function isEditor(trip) { return request.auth.token.email in trip.data.editorEmails; }
    function hasTripAccess(trip) { return trip != null && isInvited() && (isOwner(trip) || isEditor(trip)); }

    // Every invited user may read the collection (rules themselves need get() access to evaluate
    // isInvited()/isAdmin() above; matches the read-broad/write-narrow pattern already proven in
    // production for the predecessor config/appInvitations document). Only an existing admin may
    // write -- grant, revoke, or seed a new record; admin-delete-account.mjs's own Firebase Admin
    // SDK credential bypasses this entirely for the one destructive action rules can't safely gate
    // (deleting another account's data), per DESIGN_V1.md §5.
    match /invitations/{email} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /trips/{tripId} {
      allow create: if isInvited() && request.resource.data.ownerUid == request.auth.uid;
      // A plain `get` on a Trip that does not exist yet must succeed (returning exists:false, no
      // data to leak) rather than being denied -- otherwise the client's own "does this Trip
      // already exist" check before creating one is itself denied, which is exactly the bug this
      // comment exists to prevent from being reintroduced: `resource == null` short-circuits
      // before hasTripAccess ever dereferences trip.data, so a nonexistent Trip is always
      // gettable (harmlessly empty) while an existing one still requires real access. `list`
      // (used by the owned/shared-with-me queries) is unaffected -- a query only ever returns
      // documents that already exist, so `resource` is never null there.
      allow get: if isInvited() && (resource == null || hasTripAccess(resource));
      allow list: if hasTripAccess(resource);
      // CR-001 (Pre-Beta Code Health & Security Review V1): the previous unrestricted
      // `allow update: if hasTripAccess(resource)` let any Editor write to ownerUid/editorEmails
      // themselves, not just the fields the app's own UI actually exposes to them -- a real
      // privilege-escalation gap in the actual security boundary, not just a UI omission (Firestore
      // rules are the real boundary; the client UI is not). ownerUid never changes via update at
      // all (there is no ownership-transfer feature; it is only ever set once at create). editorEmails
      // may only change when the caller is the Owner -- addEditorByEmail/removeEditorByEmail
      // (cloud-store.js) are already Owner-only in the UI (sharingSection() returns '' for anyone
      // else); this closes the same gap in the rules themselves. Every other field (name, dates,
      // destinationCountries, etc.) is unaffected -- both fields stay unchanged in every write to
      // those, so the equality checks below are always trivially satisfied for that ordinary case.
      allow update: if hasTripAccess(resource)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && (request.resource.data.editorEmails == resource.data.editorEmails || isOwner(resource));
      allow delete: if isInvited() && isOwner(resource);

      match /{subcollection}/{docId} {
        allow read, write: if hasTripAccess(get(/databases/$(database)/documents/trips/$(tripId)));
      }
    }
  }
}
